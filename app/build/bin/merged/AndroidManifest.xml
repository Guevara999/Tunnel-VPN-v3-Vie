<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tunnelvpn.free"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POWER_SERVICE" />

    <application
        android:name="com.vienetworks.originvpn.SocksHttpApp"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:theme="@style/AppTheme" >
        <activity
            android:name="com.vienetworks.originvpn.LauncherActivity"
            android:theme="@style/SplashScreenTheme" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.vienetworks.originvpn.SocksHttpMainActivity"
            android:label="@string/app_name" />
        <activity
            android:name="com.vienetworks.originvpn.activities.ConfigGeralActivity"
            android:label="@string/settings"
            android:parentActivityName="com.vienetworks.originvpn.SocksHttpMainActivity" />
        <activity
            android:name="com.insure.tunnelvpn.activities.ConfigImportFileActivity"
            android:grantUriPermissions="true"
            android:label="@string/settings_import"
            android:parentActivityName="com.insure.tunnelvpn.SocksHttpMainActivity" >
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:port="*" />
                <data android:pathPattern=".*.sks" />
                <data android:pathPattern=".*..*.sks" />
                <data android:pathPattern=".*..*..*.sks" />
                <data android:pathPattern=".*..*..*..*.sks" />
                <data android:pathPattern=".*..*..*..*..*.sks" />
                <data android:pathPattern=".*..*..*..*..*..*.sks" />
                <data android:pathPattern=".*..*..*..*..*..*..*.sks" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.vienetworks.originvpn.activities.ConfigExportFileActivity"
            android:label="@string/settings_export"
            android:parentActivityName="com.vienetworks.originvpn.SocksHttpMainActivity" />
        <activity
            android:name="com.vienetworks.originvpn.activities.AboutActivity"
            android:label="@string/about"
            android:parentActivityName="com.vienetworks.originvpn.SocksHttpMainActivity" />
        <activity android:name="com.vienetworks.originvpn.ExceptionActivity" />

        <meta-data
            android:name="com.google.android.gms.ads.AD_MANAGER_APP"
            android:value="true" />

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <meta-data
            android:name="android.support.VERSION"
            android:value="25.4.0" />

        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent" />

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <activity
            android:name="com.romzkie.ultrasshservice.LaunchVpn"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:taskAffinity=".LaunchVPN"
            android:theme="@style/AppThemeLogin" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.romzkie.ultrasshservice.util.DummyActivity"
            android:allowTaskReparenting="true"
            android:alwaysRetainTaskState="false"
            android:clearTaskOnLaunch="true"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:noHistory="true"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.Translucent" />

        <receiver android:name="com.romzkie.ultrasshservice.MainReceiver" >
            <intent-filter>
                <action android:name=".MainReceiver.ACTION_SERVICE_STOP" >
                </action>
                <action android:name=".MainReceiver.ACTION_SERVICE_RESTART" >
                </action>
            </intent-filter>
        </receiver>

        <service
            android:name="com.romzkie.ultrasshservice.tunnel.vpn.TunnelVpnService"
            android:enabled="true"
            android:exported="false"
            android:label="Tunnel VPN"
            android:permission="android.permission.BIND_VPN_SERVICE" >
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <service
            android:name="com.romzkie.ultrasshservice.SocksHttpService"
            android:exported="false"
            android:label="SocksHttp Service"
            android:stopWithTask="false" >
        </service>
        <service android:name="com.romzkie.ultrasshservice.NetSpeedNotification" />

        <activity android:name="com.romzkie.compatstyle.NotImplemented" />
    </application>

</manifest>